# CaseCommand Configuration
# Copy this file: cp .env.example .env
# Then edit .env with your values

# Required: Your Anthropic API key
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Models
# CLAUDE_MODEL   — interactive chat + drafting (default: claude-opus-4-8,
#                  Anthropic's recommended model for agentic applications)
# WORKER_MODEL   — autonomous background paralegal cycles (default:
#                  claude-sonnet-5 — near-Opus agentic quality, lower cost)
# CLAUDE_MODEL=claude-opus-4-8
# WORKER_MODEL=claude-sonnet-5

# Optional: Autonomous paralegal worker
# PARALEGAL_INTERVAL — seconds between autonomous cycles (default 3600 = hourly;
#                      0 disables the background worker entirely)
# DIGEST_HOUR        — earliest hour (local) the daily digest is generated (default 6)
# CYCLE_MAX_ITERATIONS — tool-use iteration cap per cycle, bounds API spend (default 12)
# PARALEGAL_INTERVAL=3600
# DIGEST_HOUR=6
# CYCLE_MAX_ITERATIONS=12

# Optional: Server port (default: 3000)
# PORT=3000

# Optional: Log level (default: INFO)
# LOG_LEVEL=INFO

# Optional: Authentication token (disabled if empty)
# When set, all API endpoints require: Authorization: Bearer <token>
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# STRONGLY recommended for any deployed instance — this system holds client data.
# AUTH_TOKEN=

# Optional: Database path (default: ./casecommand.db)
# DATABASE_PATH=./casecommand.db

# Optional: CORS allowed origins (comma-separated, default: *)
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Optional: Session management
# SESSION_TTL_SECONDS=3600
# SESSION_CLEANUP_INTERVAL=300
# MAX_SESSIONS=1000

# Optional: Rate limiting (per IP, AI endpoints only)
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW=60

# Optional: Input size limits (characters)
# MAX_MESSAGE_LENGTH=50000
# MAX_SYSTEM_PROMPT_LENGTH=100000
